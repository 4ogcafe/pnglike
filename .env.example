# MySQL Database Configuration for RemBG Studio
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=rembg_studio

# ========================================================
# Production & Server Environment
# ========================================================
# Set to 'production' for live deployment, or 'development' for local debugging
ENVIRONMENT=production
ALLOWED_ORIGINS=https://pnglike.studio,http://127.0.0.1:7860,http://localhost:7860
MAX_UPLOAD_BYTES=52428800

# ========================================================
# Sender Mail System & Gmail Verification (SMTP)
# Powered by Div Sri
# ========================================================
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_google_app_password
SMTP_FROM_NAME="PngLike AI Studio - Powered by Div Sri"
SMTP_FROM_EMAIL=your_email@gmail.com

# ========================================================
# Google SEO APIs (/seo-google)
# ========================================================
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GSC_PROPERTY=sc-domain:pnglike.studio
GA4_PROPERTY_ID=

# ========================================================
# Bing Webmaster Tools & IndexNow (/seo-bing)
# ========================================================
BING_WEBMASTER_API_KEY=
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=

# ========================================================
# Ahrefs API Configuration (/seo-ahrefs)
# ========================================================
AHREFS_API_KEY=
MOZ_API_KEY=

# ========================================================
# Sitemap & International SEO (/seo-sitemap & /seo-hreflang)
# ========================================================
SITE_BASE_URL=https://pnglike.studio
SITEMAP_URL=https://pnglike.studio/sitemap.xml
DEFAULT_LANGUAGE=en
SUPPORTED_LOCALES=en,es,ja,de,fr
