# ==============================================================
# PngLike AI Studio - LiteSpeed & Apache Configuration (.htaccess)
# ==============================================================

# Directory default index resolution
DirectoryIndex index.html index.php /static/index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Standalone Uvicorn Reverse Proxy (Optional)
    # If running standalone Uvicorn daemon on port 7860, uncomment the RewriteRule below.
    # When using cPanel / CloudLinux / Hostinger "Setup Python App", Passenger handles
    # all /api requests directly through passenger_wsgi.py.
    # <IfModule mod_proxy.c>
    #     RewriteCond %{REQUEST_URI} ^/api/
    #     RewriteRule ^api/(.*)$ http://127.0.0.1:7860/api/$1 [P,L]
    # </IfModule>

    # 2. If the exact requested file exists on disk (e.g. robots.txt, sitemap.xml, static/*), serve it directly
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Pre-rendered SEO Blog Article Pages (Self-referencing canonicals & full SSR content for Bingbot/Googlebot)
    RewriteRule ^blog/mastering-ai-background-removal-u2net-alpha-matting/?$ /blog-mastering-ai-background-removal-u2net-alpha-matting.html [L]
    RewriteRule ^blog/ecommerce-product-photography-pure-white-studio-catalogs/?$ /blog-ecommerce-product-photography-pure-white-studio-catalogs.html [L]
    RewriteRule ^blog/inside-pnglike-9-in-1-ai-image-suite-3d-relight-cinematic/?$ /blog-inside-pnglike-9-in-1-ai-image-suite-3d-relight-cinematic.html [L]

    # 4. Clean SPA URLs -> map to root HTML files
    RewriteRule ^$ /index.html [L]
    RewriteRule ^admin/?$ /admin.html [L]
    RewriteRule ^dashboard/?$ /dashboard.html [L]
    RewriteRule ^login/?$ /dashboard.html [L]
    RewriteRule ^register/?$ /dashboard.html [L]
    RewriteRule ^verify/?$ /dashboard.html [L]
    RewriteRule ^blog/?$ /blog.html [L]
    RewriteRule ^blog/([^/]+)/?$ /blog.html [L]
    RewriteRule ^about/?$ /about.html [L]
    RewriteRule ^contact/?$ /contact.html [L]
    RewriteRule ^faq/?$ /faq.html [L]
    RewriteRule ^privacy/?$ /privacy.html [L]
    RewriteRule ^terms/?$ /terms.html [L]
    RewriteRule ^cookies/?$ /cookies.html [L]
</IfModule>

# Safe directory listing protection (mod_autoindex without forbidden Options)
<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>

# Standard MIME types
<IfModule mod_mime.c>
    AddType text/html .html
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
    AddType image/webp .webp
    AddType application/json .json
    AddType application/xml .xml
    AddType text/plain .txt
</IfModule>

# Security & Crawler Indexing Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), unload=*"

    # Explicitly instruct Bingbot & Googlebot to index public pages and skip auth portals
    <FilesMatch "^(index|blog|blog-.*|about|contact|faq|privacy|terms|cookies)\.html$">
        Header set X-Robots-Tag "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    </FilesMatch>
    <FilesMatch "^(admin|dashboard)\.html$">
        Header set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>
