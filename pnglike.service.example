# Systemd Service File for PngLike Studio
# Place in /etc/systemd/system/pnglike.service
# Run: sudo systemctl daemon-reload && sudo systemctl enable --now pnglike

[Unit]
Description=PngLike AI Image Suite Uvicorn Application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/pnglike
Environment="PATH=/var/www/pnglike/.venv/bin:/usr/local/bin:/usr/bin"
Environment="U2NET_HOME=/var/www/pnglike/models"
ExecStart=/var/www/pnglike/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 7860 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
